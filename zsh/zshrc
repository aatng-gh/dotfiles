# Shared config is the default everywhere, so a fresh clone works with no
# overlays present. A machine opts in from its ~/.zshrc:
#   zstyle ':dotfiles:load' overlays work.d
# Overlays load after conf.d so they can override shared settings.
# work.d is gitignored because this repo is public.
zstyle -a ':dotfiles:load' overlays zsh_config_dirs || zsh_config_dirs=()

for d in conf.d $zsh_config_dirs; do
  for f in "${XDG_CONFIG_HOME:-$HOME/.config}"/zsh/$d/*.zsh(N-.); do
    source "$f"
  done
done
unset f d zsh_config_dirs
